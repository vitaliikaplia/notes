{% extends 'overall/base.twig' %}

{% block content %}
<div class="editor-page">
    <div class="editor-cover" id="editor-cover" style="display:none">
        <img id="editor-cover-img" src="" alt="">
        <div class="editor-cover-actions" id="cover-actions">
            <button type="button" class="editor-cover-btn" id="cover-reposition" title="Перемістити обкладинку">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/><polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
                Перемістити
            </button>
            <button type="button" class="editor-cover-btn" id="cover-change" title="Змінити обкладинку">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                Змінити
            </button>
            <button type="button" class="editor-cover-btn" id="cover-remove" title="Видалити обкладинку">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Видалити
            </button>
        </div>
        <div class="editor-cover-reposition-hint" id="cover-reposition-hint" style="display:none">
            Перетягніть для зміни позиції
        </div>
    </div>
    <div class="editor-title-row">
        <button type="button" class="note-icon-btn" id="note-icon-btn" title="Змінити іконку">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </button>
        <div id="note-title" class="editor-title" contenteditable="true" data-placeholder="Без назви">{{ note ? note.meta.title : '' }}</div>
    </div>
    <div class="editor-meta-row">
        {% if note %}
        <div class="note-date">{{ date_format_uk(note.meta.updated_at) }}</div>
        {% endif %}
        <button type="button" class="editor-add-cover" id="cover-add">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            Додати обкладинку
        </button>
    </div>
    <div id="editorjs"></div>
    <div class="editor-footer">
        <div class="editor-breadcrumbs">
            <a href="{{ home_url }}" class="breadcrumb-item breadcrumb-home" title="Notes"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></a>
            {% for crumb in breadcrumbs %}
                <span class="breadcrumb-sep"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
                {% if crumb.url %}
                    <a href="{{ home_url }}{{ crumb.url }}/" class="breadcrumb-item">{{ crumb.title }}</a>
                {% else %}
                    <span class="breadcrumb-item">{{ crumb.title }}</span>
                {% endif %}
            {% endfor %}
            {% if note %}
                <span class="breadcrumb-sep"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
                <span class="breadcrumb-current">{{ note._title }}</span>
                <button type="button" class="breadcrumb-export" id="export-md" title="Завантажити як Markdown">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </button>
            {% endif %}
        </div>
        <span id="save-status" class="save-status"></span>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/@editorjs/editorjs@2.30.8/dist/editorjs.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/header@2.8.8/dist/header.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/list@2.0.8/dist/editorjs-list.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/checklist@1.6.0/dist/checklist.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@calumk/editorjs-codecup@1.3.0/dist/editorjs-codeCup.bundle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/quote@2.7.6/dist/quote.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/delimiter@1.4.2/dist/delimiter.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/inline-code@1.5.1/dist/inline-code.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/marker@1.4.0/dist/marker.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/link@2.6.2/dist/link.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/table@2.4.5/dist/table.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/underline@1.2.1/dist/underline.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@sotaproject/strikethrough@1.0.1/dist/bundle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/editorjs-alert@1.1.4/dist/bundle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/editorjs-toggle-block@0.3.16/dist/bundle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/image@2.10.1/dist/image.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/embed@2.7.6/dist/embed.umd.js"></script>
<script src="https://cdn.jsdelivr.net/npm/editorjs-drag-drop@1.1.16/dist/bundle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/editorjs-undo@2.0.28/dist/bundle.js"></script>
<script src="{{ assets_url }}js/page-tool.js{{ asset_ver('js/page-tool.js') }}"></script>
<script src="{{ assets_url }}js/app.js{{ asset_ver('js/app.js') }}"></script>
<script>
    initEditor({
        noteData: {{ note ? note.content|json_encode|raw : '{}' }},
        oldPath: '{{ note ? note._file : '' }}',
        createdAt: '{{ note ? note.meta.created_at : '' }}',
        homeUrl: '{{ home_url }}',
        isNew: {{ note ? 'false' : 'true' }},
        noteFolder: '{{ note_folder }}',
        noteIcon: {{ note and note.meta.icon is defined ? note.meta.icon|json_encode|raw : '""' }},
        noteCover: '{{ note and note.meta.cover is defined and note.meta.cover ? note.meta.cover : '' }}',
        coverPosition: {{ note and note.meta.cover_position is defined ? note.meta.cover_position : 50 }}
    });
</script>
{% endblock %}
