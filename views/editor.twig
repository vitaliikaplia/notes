{% extends 'overall/base.twig' %}

{% block content %}
<div class="editor-page{% if children is defined and children %} has-child-tiles{% endif %}">
    <div class="editor-cover" id="editor-cover" style="display:none">
        <img id="editor-cover-img" src="" alt="">
        <div class="editor-cover-actions" id="cover-actions">
            <button type="button" class="editor-cover-btn" id="cover-reposition" title="Reposition cover">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="5 9 2 12 5 15"/><polyline points="9 5 12 2 15 5"/><polyline points="15 19 12 22 9 19"/><polyline points="19 9 22 12 19 15"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="12" y1="2" x2="12" y2="22"/></svg>
                Reposition
            </button>
            <button type="button" class="editor-cover-btn" id="cover-change" title="Change cover">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                Change
            </button>
            <button type="button" class="editor-cover-btn" id="cover-remove" title="Remove cover">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Remove
            </button>
        </div>
        <div class="editor-cover-reposition-hint" id="cover-reposition-hint" style="display:none">
            Drag to reposition
        </div>
    </div>
    <div class="editor-title-row">
        <button type="button" class="note-icon-btn" id="note-icon-btn" title="Change icon">
            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </button>
        <div id="note-title" class="editor-title" contenteditable="true" data-placeholder="Untitled">{{ note ? note.meta.title : '' }}</div>
    </div>
    <div class="editor-meta-row">
        {% if note %}
        <div class="note-date">{{ date_format_uk(note.meta.updated_at) }}</div>
        {% endif %}
        <button type="button" class="editor-pin-btn{% if note and note.meta.pinned is defined and note.meta.pinned %} active{% endif %}" id="pin-btn" title="Pin">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17v5"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z"/></svg>
        </button>
        <button type="button" class="editor-add-cover" id="cover-add">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <span>Add cover</span>
        </button>
        <button type="button" class="editor-add-color" id="color-add">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
            <span>Color</span>
        </button>
        {% if children_count > 0 %}
        <button type="button" class="editor-children-btn" id="children-btn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            <span class="editor-children-count">{{ children_count }}</span>
        </button>
        {% endif %}
    </div>
    <div id="editorjs"></div>
    {% if children is defined and children %}
    <section class="note-children-section">
        <div class="note-children-section-title">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            Nested notes
        </div>
        <div class="notes-grid note-children-grid">
            {% for child in children %}
                <a href="{{ home_url }}{{ child.url }}/" class="note-card{% if child.cover %} has-cover{% endif %}"
                   {% if child.color %}style="--bg: {{ child.color }}; --text: {{ contrast_color(child.color) }}; background: {{ child.color }}; color: {{ contrast_color(child.color) }};"{% endif %}>
                    {% if child.cover %}
                        <span class="note-card-cover">
                            <img src="{{ child.cover }}" alt="" style="object-position: center {{ child.cover_position }}%">
                        </span>
                    {% endif %}
                    {% if child.icon %}
                        <span class="note-card-icon">
                            {%- if child.icon starts with 'data:' -%}
                                <img src="{{ child.icon }}" width="28" height="28" alt="">
                            {%- else -%}
                                {{ child.icon }}
                            {%- endif -%}
                        </span>
                    {% endif %}
                    <span class="note-card-title">{{ child.title }}</span>
                    {% if child.date %}<span class="note-card-date">{{ date_format_uk(child.date) }}</span>{% endif %}
                    {% if child.preview %}<span class="note-card-preview">{{ child.preview }}</span>{% endif %}
                </a>
            {% endfor %}
        </div>
    </section>
    {% endif %}
    <div class="editor-footer">
        <div class="editor-breadcrumbs">
            <a href="{{ home_url }}" class="breadcrumb-item breadcrumb-home" title="Notes"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></a>
            {% for crumb in breadcrumbs %}
                <span class="breadcrumb-sep"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
                {% if crumb.url %}
                    <a href="{{ home_url }}{{ crumb.url }}/" class="breadcrumb-item">{{ crumb.title }}</a>
                {% else %}
                    <span class="breadcrumb-item">{{ crumb.title }}</span>
                {% endif %}
            {% endfor %}
            {% if note %}
                <span class="breadcrumb-sep"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
                <span class="breadcrumb-current">{{ note._title }}</span>
                <button type="button" class="breadcrumb-export" id="export-note" title="Download note">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </button>
            {% endif %}
        </div>
        <span id="save-status" class="save-status"></span>
    </div>
</div>

<div id="exportTemplate" hidden>
    <div class="export-options">
        <button type="button" class="export-option js-export-md">
            <span class="export-option-icon"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M14.481 14.015c-.238 0-.393.021-.483.042v3.089c.091.021.237.021.371.021.966.007 1.597-.525 1.597-1.653.007-.981-.568-1.499-1.485-1.499z"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-2.934 15.951-.07-1.807a53.142 53.142 0 0 1-.042-1.94h-.021a26.098 26.098 0 0 1-.525 1.828l-.574 1.842H9l-.504-1.828a21.996 21.996 0 0 1-.428-1.842h-.013c-.028.638-.049 1.366-.084 1.954l-.084 1.793h-.988L7.2 13.23h1.422l.462 1.576c.147.546.295 1.135.399 1.688h.021a39.87 39.87 0 0 1 .448-1.694l.504-1.569h1.394l.26 4.721h-1.044zm5.25-.56c-.498.413-1.253.609-2.178.609a9.27 9.27 0 0 1-1.212-.07v-4.636a9.535 9.535 0 0 1 1.443-.099c.896 0 1.478.161 1.933.505.49.364.799.945.799 1.778 0 .904-.33 1.528-.785 1.913zM14 9h-1V4l5 5h-4z"/></svg></span>
            <span class="export-option-title">Markdown</span>
            <span class="export-option-desc">Plain .md file with the note content</span>
        </button>
        <button type="button" class="export-option js-export-pdf">
            <span class="export-option-icon"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M8.267 14.68c-.184 0-.308.018-.372.036v1.178c.076.018.171.023.302.023.479 0 .774-.242.774-.651 0-.366-.254-.586-.704-.586zm3.487.012c-.2 0-.33.018-.407.036v2.61c.077.018.201.018.313.018.817.006 1.349-.444 1.349-1.396.006-.83-.479-1.268-1.255-1.268z"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM9.498 16.19c-.309.29-.765.42-1.296.42a2.23 2.23 0 0 1-.308-.018v1.426H7v-3.936A7.558 7.558 0 0 1 8.219 14c.557 0 .953.106 1.22.319.254.202.426.533.426.923-.001.392-.131.723-.367.948zm3.807 1.355c-.42.349-1.059.515-1.84.515-.468 0-.799-.03-1.024-.06v-3.917A7.947 7.947 0 0 1 11.66 14c.757 0 1.249.136 1.633.426.415.308.675.799.675 1.504 0 .763-.279 1.29-.663 1.615zM17 14.77h-1.532v.911H16.9v.734h-1.432v1.604h-.906V14.03H17v.74zM14 9h-1V4l5 5h-4z"/></svg></span>
            <span class="export-option-title">PDF</span>
            <span class="export-option-desc">Formatted .pdf document, ready to print or share</span>
        </button>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ assets_url }}vendor/editorjs-2.31.6.js"></script>
<script src="{{ assets_url }}vendor/editorjs-header-2.8.9.js"></script>
<script src="{{ assets_url }}vendor/editorjs-list-2.0.9.js"></script>
<script src="{{ assets_url }}vendor/editorjs-checklist-1.6.0.js"></script>
<script src="{{ assets_url }}vendor/editorjs-codecup-1.3.0.js"></script>
<script src="{{ assets_url }}vendor/editorjs-quote-2.7.6.js"></script>
<script src="{{ assets_url }}vendor/editorjs-delimiter-1.4.2.js"></script>
<script src="{{ assets_url }}vendor/editorjs-inline-code-1.5.2.js"></script>
<script src="{{ assets_url }}vendor/editorjs-marker-1.4.0.js"></script>
<script src="{{ assets_url }}vendor/editorjs-link-2.6.2.js"></script>
<script src="{{ assets_url }}vendor/editorjs-table-2.4.6.js"></script>
<script src="{{ assets_url }}vendor/editorjs-underline-1.2.1.js"></script>
<script src="{{ assets_url }}vendor/editorjs-strikethrough-1.0.1.js"></script>
<script src="{{ assets_url }}vendor/editorjs-alert-1.1.4.js"></script>
<script src="{{ assets_url }}vendor/editorjs-toggle-block-0.3.16.js"></script>
<script src="{{ assets_url }}vendor/editorjs-image-2.10.3.js"></script>
<script src="{{ assets_url }}vendor/editorjs-embed-2.8.0.js"></script>
<script src="{{ assets_url }}vendor/editorjs-drag-drop-1.1.16.js"></script>
<script src="{{ assets_url }}vendor/editorjs-undo-2.0.28.js"></script>
<script src="{{ assets_url }}js/page-tool.js{{ asset_ver('js/page-tool.js') }}"></script>
<script src="{{ assets_url }}js/app.js{{ asset_ver('js/app.js') }}"></script>
<script>
    initEditor({
        noteData: {{ note ? note.content|json_encode|raw : '{}' }},
        oldPath: '{{ note ? note._file : '' }}',
        createdAt: '{{ note ? note.meta.created_at : '' }}',
        homeUrl: '{{ home_url }}',
        isNew: {{ note ? 'false' : 'true' }},
        noteFolder: '{{ note_folder }}',
        noteIcon: {{ note and note.meta.icon is defined ? note.meta.icon|json_encode|raw : '""' }},
        noteCover: '{{ note and note.meta.cover is defined and note.meta.cover ? note.meta.cover : '' }}',
        coverPosition: {{ note and note.meta.cover_position is defined ? note.meta.cover_position : 50 }},
        noteColor: '{{ note and note.meta.color is defined and note.meta.color ? note.meta.color : '' }}',
        notePinned: {{ note and note.meta.pinned is defined and note.meta.pinned ? 'true' : 'false' }},
        children: {{ children is defined ? children|json_encode|raw : '[]' }}
    });
</script>
{% endblock %}
