<div class="popup js-popup" aria-hidden="true">
    <div class="popupBackdrop" data-popup-close></div>
    <div class="popupDialog popupDialog--medium js-popup-dialog" role="dialog" aria-modal="true" aria-labelledby="popup-title" tabindex="-1">
        <header class="popupHeader js-popup-header">
            <h2 class="popupTitle js-popup-title" id="popup-title"></h2>
            <button class="popupClose js-popup-close" type="button" aria-label="Close" data-popup-close></button>
        </header>
        <div class="popupContent js-popup-content"></div>
        <footer class="popupActions js-popup-actions"></footer>
    </div>
</div>
