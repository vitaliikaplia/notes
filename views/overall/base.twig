<!DOCTYPE html>
<html lang="{{ site.html_loc }}">
<head>
    <meta charset="{{ site.charset }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ html_title }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ assets_url }}svg/favicon.svg{{ asset_ver('svg/favicon.svg') }}">
    <link rel="manifest" href="/manifest.json">
    {% if robots is defined and robots %}<meta name="robots" content="{{ robots }}">{% endif %}
    {% if page.description is defined and page.description %}<meta name="description" content="{{ page.description }}">{% endif %}
    {% if canonical is defined and canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
    {% if og is defined %}
    <meta property="og:title" content="{{ og.title|default(page.title) }}">
    {% if og.description %}<meta property="og:description" content="{{ og.description }}">{% endif %}
    <meta property="og:type" content="{{ og.type|default('website') }}">
    {% if og.url is defined %}<meta property="og:url" content="{{ og.url }}">{% endif %}
    <meta property="og:site_name" content="{{ site.name }}">
    {% endif %}
    <meta name="theme-color" content="#f6f2ea">
    <script>
        (function() {
            var key = 'theme-preference';
            var root = document.documentElement;
            var meta = document.querySelector('meta[name="theme-color"]');
            var stored = null;

            try {
                stored = localStorage.getItem(key);
            } catch (e) {}

            var theme = stored === 'dark' || stored === 'light'
                ? stored
                : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

            root.dataset.theme = theme;

            if (meta) {
                meta.setAttribute('content', theme === 'dark' ? '#191919' : '#f6f2ea');
            }
        })();
    </script>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="{{ assets_url }}img/apple-touch-icon.png{{ asset_ver('img/apple-touch-icon.png') }}">
    <link rel="stylesheet" href="{{ assets_url }}vendor/air-datepicker-3.6.0.css">
    <link rel="stylesheet" href="{{ assets_url }}css/style.css{{ asset_ver('css/style.css') }}">
    <script>
        (function(){
            var s = JSON.parse(localStorage.getItem('sidebar-collapsed') || '[]');
            if (s.length) {
                // Exclude ancestors of current page from collapsing
                var path = location.pathname.replace(/^\//, '').replace(/\/$/, '');
                if (path.indexOf('note/') === 0) {
                    var parts = path.substring(5).split('/');
                    // Each parent slug in the path should not be collapsed
                    for (var i = 0; i < parts.length - 1; i++) {
                        var idx = s.indexOf(parts[i]);
                        if (idx !== -1) s.splice(idx, 1);
                    }
                    localStorage.setItem('sidebar-collapsed', JSON.stringify(s));
                }
                if (s.length) {
                    var css = s.map(function(slug) {
                        return '.sidebar-folder[data-slug="' + slug + '"] > .sidebar-folder-children';
                    }).join(',') + '{display:none}';
                    var el = document.createElement('style');
                    el.id = 'collapsed-init';
                    el.textContent = css;
                    document.head.appendChild(el);
                }
            }
        })();
    </script>
    <script>if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');</script>
</head>
<body class="{{ body_classes }}" data-home-url="{{ home_url }}">

{% if authenticated %}
<div class="app">
    <header class="mobile-header">
        <button type="button" class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <a href="{{ home_url }}" class="mobile-header-title">{{ site.name }}</a>
        <button type="button" class="mobile-search-btn search-trigger" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
    </header>
    <div class="sidebar-overlay" id="sidebar-overlay"></div>
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="{{ home_url }}" class="sidebar-title">{{ site.name }}</a>
            <div class="sidebar-header-actions">
                <button class="sidebar-header-btn sidebar-collapse-all" id="collapseAllFolders" title="Collapse/expand all">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <button type="button" class="sidebar-header-btn search-trigger" title="Search (Ctrl+K)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </button>
            </div>
        </div>
        <nav class="sidebar-nav">
            {% if notes_tree.notes is not empty or notes_tree.folders is not empty %}
                {% include 'overall/sidebar.twig' with { tree: notes_tree, base_url: home_url, sortable_folder: '' } %}
                <a href="{{ home_url }}new/" class="sidebar-add-note" title="New note">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span>New note</span>
                </a>
            {% else %}
                <div class="sidebar-empty">
                    <a href="{{ home_url }}new/" class="sidebar-add-note-lg" title="New note">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span>New note</span>
                    </a>
                </div>
            {% endif %}
        </nav>
        <div class="sidebar-footer">
            <button type="button" class="btn-footer-action btn-theme-toggle" id="themeToggle" title="Toggle theme" aria-label="Toggle theme" aria-pressed="false">
                <svg class="icon-theme-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                <svg class="icon-theme-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            </button>
            <div class="sidebar-footer-actions">
                <button type="button" class="cache-button clear-cache-trigger" id="clearCacheBtn" title="Clear cache & bump assets version">
                    <svg class="cache-button-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                    <span class="cache-button-version js-cache-version">{{ assets_version }}</span>
                </button>
                <button type="button" class="btn-footer-action options-trigger" id="optionsBtn" title="Options" aria-label="Options">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </button>
                <a href="{{ home_url }}logout/" class="btn-footer-action js-popup-confirm" title="Log out"
                   data-popup-size="narrow"
                   data-popup-title="Log out"
                   data-popup-message="Are you sure you want to log out?"
                   data-popup-confirm-label="Log out"
                   data-popup-cancel-label="Cancel"
                   data-popup-confirm-style="danger">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </a>
            </div>
        </div>
    </aside>

    <main class="content">
        {% block content %}{% endblock %}
    </main>
</div>
{% else %}
<div class="app app-public">
    {% block public %}{% endblock %}
</div>
{% endif %}

{% if authenticated %}
<div id="searchTemplate" hidden>
    <div class="search-header">
        <svg class="search-header-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" class="search-input" placeholder="Search notes..." autocomplete="off" />
        <button class="search-close" type="button" aria-label="Close" data-popup-close>&times;</button>
    </div>
    <div class="search-results">
        <div class="search-hint">Start typing a note title or text</div>
    </div>
</div>
<script>
(function() {
    var homeUrl = document.body.dataset.homeUrl || '/';
    var debounceTimer = null;
    var selectedIndex = -1;

    function escapeHtml(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    // Escape the text, then wrap each query token (case-insensitive) in a <mark>.
    function highlightMatches(text, query) {
        var escaped = escapeHtml(text);
        var tokens = String(query || '').trim().split(/\s+/).filter(function(t) { return t.length >= 2; });
        if (!tokens.length) return escaped;
        tokens.sort(function(a, b) { return b.length - a.length; });
        var pattern = tokens.map(function(t) { return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }).join('|');
        try {
            return escaped.replace(new RegExp('(' + pattern + ')', 'gi'), '<mark class="search-hl">$1</mark>');
        } catch (e) {
            return escaped;
        }
    }

    function popupContent() {
        return document.querySelector('.js-popup-content');
    }

    function isSearchOpen() {
        return document.body.classList.contains('popup-open')
            && document.querySelector('.js-popup-content .search-input') !== null;
    }

    function openSearch() {
        if (!window.Popup) return;
        selectedIndex = -1;

        window.Popup.open({
            content: '#searchTemplate',
            variant: 'spotlight',
            size: 'narrow',
            showClose: false
        });

        var input = document.querySelector('.js-popup-content .search-input');
        if (input) {
            input.addEventListener('input', onSearchInput);
            setTimeout(function() { input.focus(); }, 30);
        }
    }

    function onSearchInput() {
        var content = popupContent();
        if (!content) return;
        var input = content.querySelector('.search-input');
        var results = content.querySelector('.search-results');
        if (!input || !results) return;

        var q = input.value.trim();
        selectedIndex = -1;

        if (debounceTimer) clearTimeout(debounceTimer);

        if (q.length < 2) {
            results.innerHTML = '<div class="search-hint">Start typing a note title or text</div>';
            return;
        }

        results.innerHTML = '<div class="search-hint">Searching...</div>';

        debounceTimer = setTimeout(function() {
            fetch(homeUrl + 'api/search/?q=' + encodeURIComponent(q))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data.length) {
                        results.innerHTML = '<div class="search-no-results">No results found</div>';
                        return;
                    }
                    var html = '';
                    data.forEach(function(item) {
                        html += '<a href="' + item.url + '" class="search-result-item">';
                        var iconContent = item.icon
                            ? (item.icon.indexOf('data:') === 0 ? '<img src="' + item.icon + '" width="16" height="16" alt="">' : item.icon)
                            : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';
                        html += '<span class="search-result-icon">' + iconContent + '</span>';
                        html += '<div class="search-result-body">';
                        html += '<span class="search-result-title">' + highlightMatches(item.title, q) + '</span>';
                        if (item.snippet) {
                            html += '<span class="search-result-snippet">' + highlightMatches(item.snippet, q) + '</span>';
                        }
                        if (item.path) {
                            html += '<span class="search-result-meta">' + escapeHtml(item.path) + '</span>';
                        }
                        html += '</div>';
                        html += '</a>';
                    });
                    results.innerHTML = html;
                })
                .catch(function() {
                    results.innerHTML = '<div class="search-no-results">Search error</div>';
                });
        }, 300);
    }

    function updateSelected(items) {
        items.forEach(function(el, i) {
            el.classList.toggle('is-selected', i === selectedIndex);
        });
        if (selectedIndex >= 0 && items[selectedIndex]) {
            items[selectedIndex].scrollIntoView({ block: 'nearest' });
        }
    }

    // Open on trigger click
    document.addEventListener('click', function(e) {
        if (e.target.closest('.search-trigger')) {
            e.preventDefault();
            openSearch();
        }
    });

    // Ctrl/Cmd+K toggles; arrows/Enter navigate results.
    // Escape, backdrop click and the close button are handled by the popup engine.
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
            e.preventDefault();
            if (isSearchOpen()) {
                window.Popup.close(false);
            } else {
                openSearch();
            }
            return;
        }

        if (!isSearchOpen()) return;

        var results = document.querySelector('.js-popup-content .search-results');
        if (!results) return;
        var items = results.querySelectorAll('.search-result-item');

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
            updateSelected(items);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, -1);
            updateSelected(items);
        } else if (e.key === 'Enter' && selectedIndex >= 0 && items[selectedIndex]) {
            e.preventDefault();
            items[selectedIndex].click();
        }
    });
})();
</script>
{% endif %}

{% if authenticated %}
<script>
(function() {
    var menuBtn = document.getElementById('mobile-menu-btn');
    var sidebar = document.querySelector('.sidebar');
    var overlay = document.getElementById('sidebar-overlay');

    if (menuBtn && sidebar) {
        menuBtn.addEventListener('click', function() {
            var open = sidebar.classList.toggle('open');
            if (overlay) overlay.classList.toggle('active', open);
            document.body.style.overflow = open ? 'hidden' : '';
        });
    }
    if (overlay) {
        overlay.addEventListener('click', function() {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
        });
    }
    if (sidebar) {
        sidebar.addEventListener('click', function(e) {
            if (e.target.closest('.sidebar-note, .sidebar-note-parent, .sidebar-add-note')) {
                sidebar.classList.remove('open');
                if (overlay) overlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        });
    }
})();
</script>
{% endif %}

{% if authenticated %}
<div class="drop-overlay" id="dropOverlay">
    <div class="drop-overlay-inner">
        <svg class="drop-overlay-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 12 15 15"/></svg>
    </div>
</div>
<script>
window.showToast = function(message) {
    var toast = document.getElementById('sidebar-toast');
    if (!toast) {
        toast = document.createElement('div');
        toast.id = 'sidebar-toast';
        toast.className = 'sidebar-toast';
        document.body.appendChild(toast);
    }
    toast.textContent = message;
    toast.classList.add('visible');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(function() { toast.classList.remove('visible'); }, 2500);
};

(function() {
    var homeUrl = document.body.dataset.homeUrl || '/';
    var dropOverlay = document.getElementById('dropOverlay');
    var dragCount = 0;

    document.addEventListener('dragenter', function(e) {
        e.preventDefault();
        dragCount++;
        if (e.dataTransfer.types.indexOf('Files') !== -1) {
            dropOverlay.classList.add('active');
        }
    });

    document.addEventListener('dragleave', function(e) {
        e.preventDefault();
        dragCount--;
        if (dragCount <= 0) {
            dragCount = 0;
            dropOverlay.classList.remove('active');
        }
    });

    document.addEventListener('dragover', function(e) {
        e.preventDefault();
    });

    function isImageFile(f) {
        return /^image\/(jpeg|png|gif|webp)$/.test(f.type);
    }

    function isMdFile(f) {
        return f.name.endsWith('.md') || f.name.endsWith('.markdown');
    }

    function importMd(f) {
        var reader = new FileReader();
        window.showToast('Importing ' + f.name + '...');
        reader.onload = function(ev) {
            var md = ev.target.result;
            var title = f.name.replace(/\.(md|markdown)$/, '');
            fetch(homeUrl + 'api/import-md/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title: title, markdown: md })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success && data.url) {
                    window.showToast('Note imported');
                    window.location.href = homeUrl + data.url + '/';
                } else {
                    window.showToast('Import error');
                    window.location.reload();
                }
            })
            .catch(function() { window.showToast('Import error'); });
        };
        reader.readAsText(f);
    }

    function insertImage(f) {
        var editor = window.noteEditor;
        if (!editor) return;

        window.showToast('Uploading image...');
        var formData = new FormData();
        formData.append('image', f);

        fetch(homeUrl + 'api/upload-image/', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success && data.file && data.file.url) {
                editor.blocks.insert('image', {
                    file: { url: data.file.url },
                    caption: '',
                    withBorder: false,
                    stretched: false,
                    withBackground: false
                });
                window.showToast('Image added');
            } else {
                window.showToast('Upload error');
            }
        })
        .catch(function() { window.showToast('Upload error'); });
    }

    document.addEventListener('drop', function(e) {
        e.preventDefault();
        dragCount = 0;
        dropOverlay.classList.remove('active');

        // Sidebar note drop → insert page block in editor
        var noteData = e.dataTransfer.getData('application/x-note');
        if (noteData && window.noteEditor) {
            try {
                var note = JSON.parse(noteData);
                var pageUrl = (note.url || '').replace(homeUrl, '').replace(/\/$/, '');
                window.noteEditor.blocks.insert('page', {
                    title: note.title,
                    pageUrl: pageUrl,
                    pagePath: note.path,
                    icon: note.icon || ''
                });
                window.showToast('Link to "' + note.title + '" added');
            } catch(err) {}
            return;
        }

        var files = e.dataTransfer.files;
        if (!files.length) return;

        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            if (isMdFile(file)) {
                importMd(file);
            } else if (isImageFile(file)) {
                insertImage(file);
            }
        }
    });
})();
</script>
{% endif %}

{% if authenticated %}
<script src="{{ assets_url }}js/sidebar.js{{ asset_ver('js/sidebar.js') }}"></script>
{% include 'overall/options.twig' %}
<script src="{{ assets_url }}js/options.js{{ asset_ver('js/options.js') }}"></script>
<script>
(function() {
    var btn = document.getElementById('clearCacheBtn');
    if (!btn) return;
    var homeUrl = document.body.dataset.homeUrl || '/';
    var icon = btn.querySelector('.cache-button-icon');
    var versionEl = btn.querySelector('.js-cache-version');
    var rotation = 0;

    btn.addEventListener('click', function() {
        if (btn.disabled) return;
        btn.disabled = true;
        rotation += 360;
        if (icon) icon.style.transform = 'rotate(' + rotation + 'deg)';

        fetch(homeUrl + 'api/clear-cache', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.assets_version && versionEl) versionEl.textContent = data.assets_version;
                if (window.showToast) window.showToast(data && data.success ? 'Cache cleared' : 'Failed to clear cache');
            })
            .catch(function() { if (window.showToast) window.showToast('Failed to clear cache'); })
            .finally(function() { btn.disabled = false; });
    });
})();
</script>
{% endif %}

