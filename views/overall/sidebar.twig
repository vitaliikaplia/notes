{# Recursive sidebar tree #}
{% if tree.folders is not empty %}
    {% for folder in tree.folders %}
        <div class="sidebar-folder">
            <div class="sidebar-folder-header">
                <button class="folder-toggle" data-toggle="folder"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></button>
                <span class="folder-name">{{ folder.name }}</span>
                <a href="{{ base_url }}new/{{ folder.path }}/" class="folder-add" title="Нова нотатка в теці">+</a>
            </div>
            <div class="sidebar-folder-children">
                {% include 'overall/sidebar.twig' with { tree: folder.children, base_url: base_url, sortable_folder: folder.path } %}
            </div>
        </div>
    {% endfor %}
{% endif %}

{% if tree.notes is not empty %}
    <div class="sidebar-notes-sortable" data-sortable="{{ sortable_folder|default('') }}">
    {% for note in tree.notes %}
        {% set note_icon = note.meta.icon|default('') %}
        {% if note._children is defined and (note._children.notes is not empty or note._children.folders is not empty) %}
            <div class="sidebar-folder" draggable="true" data-slug="{{ note._slug }}" data-path="{{ note._file }}">
                <div class="sidebar-folder-header">
                    <span class="sidebar-note-icon has-toggle" data-toggle="folder">
                        <span class="sidebar-note-icon__icon">{% if note_icon %}{{ note_icon }}{% else %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>{% endif %}</span>
                        <span class="sidebar-note-icon__toggle"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></span>
                    </span>
                    <a href="{{ base_url }}note/{{ note._url }}/" class="sidebar-note-parent">{{ note._title }}</a>
                    <a href="{{ base_url }}new/{{ note._file|replace({'.json': ''}) }}/" class="sidebar-note-add" title="Нова дочірня нотатка">+</a>
                    <button class="sidebar-note-visibility" data-path="{{ note._file }}" data-visibility="{{ note.meta.visibility|default('private') }}" title="Видимість">
                        <svg class="icon-lock" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        <svg class="icon-link" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                        <svg class="icon-globe" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    </button>
                    <button class="sidebar-note-delete" data-path="{{ note._file }}" title="Видалити">
                        <svg class="icon-trash" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </button>
                </div>
                <div class="sidebar-folder-children">
                    {% include 'overall/sidebar.twig' with { tree: note._children, base_url: base_url, sortable_folder: note._file|replace({'.json': ''}) } %}
                </div>
            </div>
        {% else %}
            <div class="sidebar-note-item" draggable="true" data-slug="{{ note._slug }}" data-path="{{ note._file }}">
                <a href="{{ base_url }}note/{{ note._url }}/" class="sidebar-note">
                    <span class="sidebar-note-icon">{% if note_icon %}{{ note_icon }}{% else %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>{% endif %}</span>
                    {{ note._title }}
                </a>
                <a href="{{ base_url }}new/{{ note._file|replace({'.json': ''}) }}/" class="sidebar-note-add" title="Нова дочірня нотатка">+</a>
                <button class="sidebar-note-visibility" data-path="{{ note._file }}" data-visibility="{{ note.meta.visibility|default('private') }}" title="Видимість">
                    <svg class="icon-lock" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <svg class="icon-link" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                    <svg class="icon-globe" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                </button>
                <button class="sidebar-note-delete" data-path="{{ note._file }}" title="Видалити">
                    <svg class="icon-trash" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                    <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </button>
            </div>
        {% endif %}
    {% endfor %}
    </div>
{% endif %}
