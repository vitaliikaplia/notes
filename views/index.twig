{% extends 'overall/base.twig' %}

{% block content %}
{% if recent_notes is not empty %}
    <div class="index-header">
        <h2 class="index-title">Останні нотатки</h2>
        <div class="view-toggle">
            <button class="view-toggle-btn active" data-view="grid" title="Плитки">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </button>
            <button class="view-toggle-btn" data-view="list" title="Список">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            </button>
        </div>
    </div>

    <div class="notes-grid" id="notes-view">
        {% for note in recent_notes %}
            <a href="{{ home_url }}note/{{ note._url }}/" class="note-card">
                {% set card_icon = note.meta.icon|default('') %}
                {% if card_icon %}
                    <span class="note-card-icon">
                        {%- if card_icon starts with 'data:' -%}
                            <img src="{{ card_icon }}" width="28" height="28" alt="">
                        {%- else -%}
                            {{ card_icon }}
                        {%- endif -%}
                    </span>
                {% endif %}
                <span class="note-card-title">{{ note._title }}</span>
                <span class="note-card-date">{{ date_format_uk(note.meta.updated_at) }}</span>
                {% if note.content.blocks is not empty %}
                    <span class="note-card-preview">
                        {% for block in note.content.blocks|slice(0, 2) %}
                            {% if block.type == 'paragraph' %}
                                {{ block.data.text|striptags|slice(0, 100) }}
                            {% endif %}
                        {% endfor %}
                    </span>
                {% endif %}
            </a>
        {% endfor %}
    </div>
{% else %}
    <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <p>Ще немає нотаток</p>
        <a href="{{ home_url }}new/" class="btn btn-primary">Створити першу нотатку</a>
    </div>
{% endif %}

<script>
(function() {
    const view = document.getElementById('notes-view');
    if (!view) return;
    const btns = document.querySelectorAll('.view-toggle-btn');
    const saved = localStorage.getItem('notes-view') || 'grid';

    function setView(mode) {
        view.className = mode === 'list' ? 'notes-list' : 'notes-grid';
        btns.forEach(b => b.classList.toggle('active', b.dataset.view === mode));
        localStorage.setItem('notes-view', mode);
    }

    setView(saved);
    btns.forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));
})();
</script>
{% endblock %}
