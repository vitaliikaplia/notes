{% extends 'overall/base.twig' %}

{% block content %}
{% if recent_notes is not empty %}
    <div class="index-header">
        <div class="index-tabs">
            <button class="index-tab active" data-tab="notes">Нотатки</button>
            <button class="index-tab" data-tab="graph">Граф</button>
            <button class="index-tab" data-tab="media">Зображення</button>
            <button class="index-tab" data-tab="timeline">Таймлайн</button>
            {% if ai_configured %}<button class="index-tab" data-tab="ai">ШІ</button>{% endif %}
        </div>
        <div class="index-controls" id="index-controls">
            <select class="index-select" id="sort-select">
                <option value="recent">Останні</option>
                <option value="oldest">Найстаріші</option>
                <option value="az">А — Я</option>
                <option value="za">Я — А</option>
            </select>
            <select class="index-select" id="filter-select">
                <option value="">Усі нотатки</option>
                {% for group in parent_groups %}
                    <option value="{{ group.file }}">{{ group.title }}</option>
                {% endfor %}
            </select>
            <button class="view-toggle-btn active" data-view="grid" title="Плитки">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
            </button>
            <button class="view-toggle-btn" data-view="list" title="Список">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            </button>
        </div>
        <div class="index-controls" id="timeline-controls" style="display:none">
            <input type="text" class="index-select tl-datepicker" id="timeline-from" placeholder="Від" readonly>
            <span class="timeline-range-sep">—</span>
            <input type="text" class="index-select tl-datepicker" id="timeline-to" placeholder="До" readonly>
            <button class="view-toggle-btn" id="timeline-reset" title="Скинути">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        {% if ai_configured %}
        <div class="index-controls" id="ai-controls" style="display:none">
            <button class="graph-reset-btn ai-clear-btn" id="ai-clear-btn" title="Очистити історію">
                <svg class="icon-reset" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="graph-reset-label">Очистити історію</span>
            </button>
        </div>
        {% endif %}
    </div>

    <div id="tab-notes" class="tab-content active">
        <div class="notes-grid" id="notes-view">
            {% for note in recent_notes %}
                <a href="{{ home_url }}note/{{ note._url }}/" class="note-card{% if note.meta.cover is defined and note.meta.cover %} has-cover{% endif %}"
                   data-date="{{ note.meta.updated_at }}"
                   data-title="{{ note._title|lower }}"
                   data-parent="{{ note._file|split('/')|length > 1 ? note._file|split('/')|slice(0, -1)|join('/') ~ '.json' : '' }}"
                   {% if note.meta.color is defined and note.meta.color %}style="--bg: {{ note.meta.color }}; --text: {{ contrast_color(note.meta.color) }}; background: {{ note.meta.color }}; color: {{ contrast_color(note.meta.color) }};"{% endif %}>
                    {% if note.meta.cover is defined and note.meta.cover %}
                        <span class="note-card-cover">
                            <img src="{{ note.meta.cover }}" alt="" style="object-position: center {{ note.meta.cover_position is defined ? note.meta.cover_position : 50 }}%">
                        </span>
                    {% endif %}
                    {% set card_icon = note.meta.icon|default('') %}
                    {% if card_icon %}
                        <span class="note-card-icon">
                            {%- if card_icon starts with 'data:' -%}
                                <img src="{{ card_icon }}" width="28" height="28" alt="">
                            {%- else -%}
                                {{ card_icon }}
                            {%- endif -%}
                        </span>
                    {% endif %}
                    <span class="note-card-title">{{ note._title }}</span>
                    <span class="note-card-date">{{ date_format_uk(note.meta.updated_at) }}</span>
                    {% if note.content.blocks is not empty %}
                        <span class="note-card-preview">
                            {% for block in note.content.blocks|slice(0, 2) %}
                                {% if block.type == 'paragraph' %}
                                    {{ block.data.text|striptags|slice(0, 100) }}
                                {% endif %}
                            {% endfor %}
                        </span>
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    </div>

    <div id="tab-graph" class="tab-content">
        <button class="graph-reset-btn" id="graph-reset-btn" title="Скинути позиції нод">
            <svg class="icon-reset" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
            <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="graph-reset-label">Скинути</span>
        </button>
        <div id="mindmap" class="mindmap-container mindmap-fullscreen"></div>
    </div>

    <div id="tab-media" class="tab-content">
        {% if media_items is empty %}
        <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <p>Нотатки з зображеннями відсутні</p>
        </div>
        {% else %}
        <div class="media-grid">
            {% for item in media_items %}
            <a href="{{ item.url }}" class="media-card">
                <img src="{{ item.image }}" loading="lazy" alt="">
                <div class="media-card-overlay">
                    <span class="media-card-title">{{ item.title }}</span>
                    <span class="media-card-date">{{ date_format_uk(item.date) }}</span>
                    {% if item.preview %}<span class="media-card-preview">{{ item.preview }}</span>{% endif %}
                </div>
            </a>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    <div id="tab-timeline" class="tab-content">
        <div class="timeline" id="timeline-view">
            <div class="timeline-track">
                {% set current_day = '' %}
                {% for note in recent_notes %}
                    {% set note_day = note.meta.updated_at|slice(0, 10) %}
                    {% if note_day != current_day %}
                        {% if current_day != '' %}</div>{% endif %}
                        {% set current_day = note_day %}
                        <div class="timeline-day-group" data-date="{{ note_day }}">
                            <div class="timeline-day-label">{{ date_format_uk(note_day ~ ' 00:00:00')|slice(0, -7) }}</div>
                            <div class="timeline-day-tick"></div>
                    {% endif %}
                    <a href="{{ home_url }}note/{{ note._url }}/" class="timeline-card">
                        <span class="timeline-card-time">{{ note.meta.updated_at|slice(11, 5) }}</span>
                        {% if note.meta.icon %}
                            <span class="timeline-card-icon">
                                {%- if note.meta.icon starts with 'data:' -%}
                                    <img src="{{ note.meta.icon }}" width="20" height="20" alt="">
                                {%- else -%}
                                    {{ note.meta.icon }}
                                {%- endif -%}
                            </span>
                        {% endif %}
                        <span class="timeline-card-title">{{ note._title }}</span>
                    </a>
                {% endfor %}
                {% if current_day != '' %}</div>{% endif %}
            </div>
        </div>
    </div>

    {% if ai_configured %}
    <div id="tab-ai" class="tab-content">
        <div class="ai-chat-messages" id="ai-messages"></div>
        <div class="ai-chat-input-wrap">
            <div class="ai-chat-input-inner">
                <textarea class="ai-chat-input" id="ai-input" placeholder="Напишіть повідомлення..." rows="1"></textarea>
                <button class="ai-chat-send" id="ai-send" title="Надіслати">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </div>
        </div>
    </div>
    {% endif %}
{% else %}
    <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <p>Ще немає нотаток</p>
        <a href="{{ home_url }}new/" class="btn btn-primary">Створити першу нотатку</a>
    </div>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/force-graph@1.49.5/dist/force-graph.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/air-datepicker@3.6.0/air-datepicker.js"></script>
<script>
(function() {
    const homeUrl = '{{ home_url }}';

    // --- Grid/List toggle ---
    const view = document.getElementById('notes-view');
    if (!view) return;
    const viewBtns = document.querySelectorAll('.view-toggle-btn');
    const savedView = localStorage.getItem('notes-view') || 'grid';
    var currentViewMode = savedView;

    function setView(mode) {
        currentViewMode = mode;
        view.className = mode === 'list' ? 'notes-list' : 'notes-grid';
        viewBtns.forEach(b => b.classList.toggle('active', b.dataset.view === mode));
        localStorage.setItem('notes-view', mode);
        if (mode === 'list') {
            clearMasonry();
        } else {
            layoutMasonry();
        }
    }

    setView(savedView);
    viewBtns.forEach(b => b.addEventListener('click', () => setView(b.dataset.view)));

    // --- Sort, Filter & Infinite Scroll ---
    const sortSelect = document.getElementById('sort-select');
    const filterSelect = document.getElementById('filter-select');
    var notesOffset = view.querySelectorAll('.note-card').length;
    var notesLoading = false;
    var notesHasMore = {{ recent_notes|length >= 35 ? 'true' : 'false' }};
    var NOTES_PER_PAGE = 35;

    sortSelect.value = localStorage.getItem('notes-sort') || 'recent';
    filterSelect.value = localStorage.getItem('notes-filter') || '';

    function applyFilter() {
        var filter = filterSelect.value;
        view.querySelectorAll('.note-card').forEach(function(card) {
            card.style.display = (!filter || card.dataset.parent === filter) ? '' : 'none';
        });
    }

    function getContrastColor(hex) {
        hex = hex.replace('#', '');
        var r = parseInt(hex.substring(0, 2), 16) / 255;
        var g = parseInt(hex.substring(2, 4), 16) / 255;
        var b = parseInt(hex.substring(4, 6), 16) / 255;
        r = r <= 0.03928 ? r / 12.92 : Math.pow((r + 0.055) / 1.055, 2.4);
        g = g <= 0.03928 ? g / 12.92 : Math.pow((g + 0.055) / 1.055, 2.4);
        b = b <= 0.03928 ? b / 12.92 : Math.pow((b + 0.055) / 1.055, 2.4);
        var luminance = 0.2126 * r + 0.7152 * g + 0.0722 * b;
        return luminance > 0.4 ? '#302b25' : '#f5f5f5';
    }

    function buildCardHtml(card) {
        var hasCover = card.cover ? ' has-cover' : '';
        var colorStyle = '';
        if (card.color) {
            var tc = getContrastColor(card.color);
            colorStyle = ' style="--bg: ' + card.color + '; --text: ' + tc + '; background: ' + card.color + '; color: ' + tc + ';"';
        }
        var html = '<a href="' + homeUrl + 'note/' + card.url + '/" class="note-card' + hasCover + '"'
            + ' data-date="' + (card.date || '') + '"'
            + ' data-title="' + (card.title || '').toLowerCase() + '"'
            + ' data-parent="' + (card.parent || '') + '"'
            + colorStyle + '>';
        if (card.cover) {
            html += '<span class="note-card-cover"><img src="' + card.cover + '" alt="" style="object-position: center ' + (card.cover_position || 50) + '%"></span>';
        }
        if (card.icon) {
            html += '<span class="note-card-icon">';
            html += card.icon.indexOf('data:') === 0
                ? '<img src="' + card.icon + '" width="28" height="28" alt="">'
                : card.icon;
            html += '</span>';
        }
        html += '<span class="note-card-title">' + card.title + '</span>';
        html += '<span class="note-card-date">' + card.date_fmt + '</span>';
        if (card.preview) html += '<span class="note-card-preview">' + card.preview + '</span>';
        html += '</a>';
        return html;
    }

    function renderCards(cards, append) {
        if (!append) view.innerHTML = '';
        var filter = filterSelect.value;
        var tmp = document.createElement('div');
        cards.forEach(function(card) {
            tmp.innerHTML = buildCardHtml(card);
            var el = tmp.firstElementChild;
            if (filter && el.dataset.parent !== filter) el.style.display = 'none';
            view.appendChild(el);
        });
    }

    // --- JS Masonry ---
    var masonryGap = 12;
    var masonryMinCol = 220;
    var colHeights = [];
    var masonryNumCols = 0;
    var masonryColWidth = 0;

    function calcMasonryCols() {
        var cs = getComputedStyle(view);
        var padL = parseFloat(cs.paddingLeft) || 0;
        var padR = parseFloat(cs.paddingRight) || 0;
        var w = view.offsetWidth - padL - padR;
        var n = Math.floor((w + masonryGap) / (masonryMinCol + masonryGap)) || 1;
        var cw = (w - masonryGap * (n - 1)) / n;
        return { numCols: n, colWidth: cw, padLeft: padL };
    }

    var masonryPadLeft = 0;

    function layoutMasonry(fromIndex) {
        if (currentViewMode === 'list') return;
        var info = calcMasonryCols();
        var fullRelayout = !fromIndex || info.numCols !== masonryNumCols;
        masonryNumCols = info.numCols;
        masonryColWidth = info.colWidth;
        masonryPadLeft = info.padLeft;

        var cards = view.querySelectorAll('.note-card');
        var start = 0;
        if (fullRelayout) {
            colHeights = new Array(masonryNumCols).fill(0);
            start = 0;
        } else {
            start = fromIndex;
        }

        view.style.position = 'relative';

        for (var i = start; i < cards.length; i++) {
            var card = cards[i];
            if (card.style.display === 'none') continue;
            card.style.position = 'absolute';
            card.style.width = masonryColWidth + 'px';

            var minCol = 0;
            for (var j = 1; j < masonryNumCols; j++) {
                if (colHeights[j] < colHeights[minCol]) minCol = j;
            }

            card.style.left = (masonryPadLeft + minCol * (masonryColWidth + masonryGap)) + 'px';
            card.style.top = colHeights[minCol] + 'px';
            colHeights[minCol] += card.offsetHeight + masonryGap;
        }

        var maxH = 0;
        for (var k = 0; k < colHeights.length; k++) {
            if (colHeights[k] > maxH) maxH = colHeights[k];
        }
        view.style.height = maxH + 'px';
    }

    function clearMasonry() {
        view.style.position = '';
        view.style.height = '';
        view.querySelectorAll('.note-card').forEach(function(card) {
            card.style.position = '';
            card.style.width = '';
            card.style.left = '';
            card.style.top = '';
        });
        colHeights = [];
        masonryNumCols = 0;
    }

    var resizeTimer;
    window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
            if (currentViewMode !== 'list') layoutMasonry();
        }, 150);
    });

    function reloadNotes() {
        notesLoading = true;
        fetch(homeUrl + 'api/notes-page/?offset=0&limit=' + NOTES_PER_PAGE + '&sort=' + sortSelect.value)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                renderCards(data.cards || [], false);
                notesOffset = data.cards ? data.cards.length : 0;
                notesHasMore = data.has_more;
                notesLoading = false;
                layoutMasonry();
            })
            .catch(function() { notesLoading = false; });
    }

    function loadMoreNotes() {
        if (notesLoading || !notesHasMore) return;
        notesLoading = true;
        var prevCount = view.querySelectorAll('.note-card').length;
        fetch(homeUrl + 'api/notes-page/?offset=' + notesOffset + '&limit=' + NOTES_PER_PAGE + '&sort=' + sortSelect.value)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.cards && data.cards.length) {
                    renderCards(data.cards, true);
                    notesOffset += data.cards.length;
                    layoutMasonry(prevCount);
                }
                notesHasMore = data.has_more;
                notesLoading = false;
            })
            .catch(function() { notesLoading = false; notesHasMore = false; });
    }

    sortSelect.addEventListener('change', () => {
        localStorage.setItem('notes-sort', sortSelect.value);
        reloadNotes();
    });
    filterSelect.addEventListener('change', () => {
        localStorage.setItem('notes-filter', filterSelect.value);
        applyFilter();
        layoutMasonry();
    });

    // Initial layout
    if (sortSelect.value !== 'recent') {
        reloadNotes();
    } else {
        applyFilter();
        layoutMasonry();
    }

    // Sentinel element for infinite scroll
    var sentinel = document.createElement('div');
    sentinel.style.height = '1px';
    view.parentNode.appendChild(sentinel);

    var scrollObserver = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting && notesHasMore && !notesLoading) {
            loadMoreNotes();
        }
    }, { rootMargin: '300px' });

    // Delay observe to avoid triggering on initial layout
    setTimeout(function() { scrollObserver.observe(sentinel); }, 800);

    // --- Tab switching ---
    const tabs = document.querySelectorAll('.index-tab');
    const tabNotes = document.getElementById('tab-notes');
    const tabGraph = document.getElementById('tab-graph');
    const tabTimeline = document.getElementById('tab-timeline');
    const tabMedia = document.getElementById('tab-media');
    const tabAi = document.getElementById('tab-ai');
    const indexControls = document.getElementById('index-controls');
    const timelineControls = document.getElementById('timeline-controls');
    const aiControls = document.getElementById('ai-controls');
    const savedTab = localStorage.getItem('dashboard-tab') || 'notes';
    let graphInited = false;
    let mindmapGraph = null;
    let mindmapPalette = null;

    const indexHeader = document.querySelector('.index-header');

    function setTab(name) {
        tabs.forEach(t => t.classList.toggle('active', t.dataset.tab === name));
        tabNotes.classList.toggle('active', name === 'notes');
        tabGraph.classList.toggle('active', name === 'graph');
        tabMedia.classList.toggle('active', name === 'media');
        tabTimeline.classList.toggle('active', name === 'timeline');
        if (tabAi) tabAi.classList.toggle('active', name === 'ai');
        indexControls.style.display = name === 'notes' ? '' : 'none';
        timelineControls.style.display = name === 'timeline' ? '' : 'none';
        if (aiControls) aiControls.style.display = name === 'ai' ? '' : 'none';
        indexHeader.classList.toggle('graph-active', name === 'graph');
        indexHeader.classList.toggle('ai-active', name === 'ai');
        document.body.classList.toggle('ai-chat-active', name === 'ai');
        localStorage.setItem('dashboard-tab', name);

        requestAnimationFrame(() => {
            tabs.forEach(t => {
                if (t.dataset.tab === name) {
                    t.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
                }
            });
        });

        if (name === 'graph' && !graphInited) {
            graphInited = true;
            initMindmap();
        }
    }

    setTab(savedTab);

    // --- Timeline date filter ---
    var tlGroups = document.querySelectorAll('.timeline-day-group');
    var tlReset = document.getElementById('timeline-reset');

    var localeUk = {
        days: ['Неділя', 'Понеділок', 'Вівторок', 'Середа', 'Четвер', "П'ятниця", 'Субота'],
        daysShort: ['Нд', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'],
        daysMin: ['Нд', 'Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб'],
        months: ['Січень', 'Лютий', 'Березень', 'Квітень', 'Травень', 'Червень', 'Липень', 'Серпень', 'Вересень', 'Жовтень', 'Листопад', 'Грудень'],
        monthsShort: ['Січ', 'Лют', 'Бер', 'Кві', 'Тра', 'Чер', 'Лип', 'Сер', 'Вер', 'Жов', 'Лис', 'Гру'],
        today: 'Сьогодні',
        clear: 'Очистити',
        dateFormat: 'dd.MM.yyyy',
        timeFormat: 'HH:mm',
        firstDay: 1
    };

    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function toYmd(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }

    function getPickerDate(dp) {
        if (!dp) return '';
        var d = dp.selectedDates[0];
        return d ? toYmd(d) : '';
    }

    function filterTimeline() {
        var from = getPickerDate(dpFrom);
        var to = getPickerDate(dpTo);
        tlGroups.forEach(function(g) {
            var date = g.dataset.date;
            var show = (!from || date >= from) && (!to || date <= to);
            g.style.display = show ? '' : 'none';
        });
        tlReset.style.opacity = (from || to) ? '1' : '0.3';
        localStorage.setItem('timeline-from', from);
        localStorage.setItem('timeline-to', to);
    }

    var savedFrom = localStorage.getItem('timeline-from') || '';
    var savedTo = localStorage.getItem('timeline-to') || '';

    var dpOpts = { locale: localeUk, autoClose: true, onSelect: function() { filterTimeline(); } };

    var dpFrom = new AirDatepicker('#timeline-from', Object.assign({}, dpOpts, {
        position: 'bottom left',
        selectedDates: savedFrom ? [new Date(savedFrom + 'T00:00:00')] : []
    }));

    var dpTo = new AirDatepicker('#timeline-to', Object.assign({}, dpOpts, {
        position: 'bottom right',
        selectedDates: savedTo ? [new Date(savedTo + 'T00:00:00')] : []
    }));

    tlReset.addEventListener('click', function() {
        dpFrom.clear();
        dpTo.clear();
        filterTimeline();
    });

    tlReset.style.opacity = (savedFrom || savedTo) ? '1' : '0.3';
    if (savedFrom || savedTo) filterTimeline();

    // Scroll timeline to the right (newest notes)
    var tlView = document.getElementById('timeline-view');
    if (tlView) tlView.scrollLeft = tlView.scrollWidth;

    // --- Graph reset button (two-click confirm like sidebar delete) ---
    var resetBtn = document.getElementById('graph-reset-btn');
    var resetTimer = null;
    resetBtn.addEventListener('click', async () => {
        if (!resetBtn.classList.contains('confirm')) {
            resetBtn.classList.add('confirm');
            if (resetTimer) clearTimeout(resetTimer);
            resetTimer = setTimeout(() => resetBtn.classList.remove('confirm'), 3000);
            return;
        }
        resetBtn.classList.remove('confirm');
        await fetch('{{ home_url }}api/graph/', { method: 'DELETE' });
        location.reload();
    });
    tabs.forEach(t => t.addEventListener('click', () => setTab(t.dataset.tab)));

    // --- Mindmap (lazy init) ---
    function getMindmapPalette() {
        const cs = getComputedStyle(document.documentElement);
        return {
            textColor: cs.getPropertyValue('--text').trim() || '#e0e0e0',
            bgColor: cs.getPropertyValue('--bg').trim() || '#191919',
            borderColor: cs.getPropertyValue('--border').trim() || '#363636',
            accentColor: cs.getPropertyValue('--primary').trim() || '#54c0eb'
        };
    }

    function refreshMindmapTheme() {
        const container = document.getElementById('mindmap');
        if (!mindmapGraph || !container) return;

        mindmapPalette = getMindmapPalette();
        mindmapGraph
            .backgroundColor(mindmapPalette.bgColor)
            .linkColor(() => mindmapPalette.borderColor)
            .width(container.clientWidth)
            .height(container.clientHeight);

        if (typeof mindmapGraph.refresh === 'function') {
            mindmapGraph.refresh();
        } else if (typeof mindmapGraph.d3ReheatSimulation === 'function') {
            mindmapGraph.d3ReheatSimulation();
        }
    }

    window.addEventListener('themechange', refreshMindmapTheme);

    function initMindmap() {
        const container = document.getElementById('mindmap');
        if (!container) return;

        mindmapPalette = getMindmapPalette();

        fetch(homeUrl + 'api/graph/')
            .then(r => r.json())
            .then(data => {
                if (!data.nodes || !data.nodes.length) {
                    container.innerHTML = '<div class="mindmap-empty">Недостатньо нотаток для карти</div>';
                    return;
                }

                const nodeIds = new Set(data.nodes.map(n => n.id));

                const degree = {};
                data.nodes.forEach(n => { degree[n.id] = 0; });
                data.edges.forEach(e => {
                    if (nodeIds.has(e.source) && nodeIds.has(e.target)) {
                        degree[e.source] = (degree[e.source] || 0) + 1;
                        degree[e.target] = (degree[e.target] || 0) + 1;
                    }
                });

                const nodes = data.nodes.map(n => {
                    let label = n.title;
                    const isEmoji = n.icon && !n.icon.startsWith('data:') && !n.icon.startsWith('<');
                    if (isEmoji) label = n.icon + ' ' + label;
                    const node = {
                        id: n.id,
                        label: label,
                        url: n.url,
                        deg: degree[n.id] || 0,
                        icon: n.icon || '',
                        color: n.color || '',
                    };
                    // Restore saved position (pin the node)
                    if (n.fx !== undefined && n.fy !== undefined) {
                        node.fx = n.fx;
                        node.fy = n.fy;
                    }
                    return node;
                });

                const links = data.edges
                    .filter(e => nodeIds.has(e.source) && nodeIds.has(e.target))
                    .map(e => ({
                        source: e.source,
                        target: e.target,
                        type: e.type,
                    }));

                const width = container.clientWidth;
                const height = container.clientHeight;

                const graph = ForceGraph()(container)
                    .width(width)
                    .height(height)
                    .backgroundColor(mindmapPalette.bgColor)
                    .graphData({ nodes, links })
                    .nodeCanvasObject((node, ctx, globalScale) => {
                        const r = Math.max(2, Math.min(8, 2 + node.deg * 1.5));
                        ctx.beginPath();
                        ctx.arc(node.x, node.y, r, 0, 2 * Math.PI);
                        ctx.fillStyle = node === graph.hoverNode ? mindmapPalette.textColor : (node.color || mindmapPalette.accentColor);
                        ctx.globalAlpha = 0.85;
                        ctx.fill();
                        ctx.globalAlpha = 1;

                        const fontSize = Math.max(3, 10 / globalScale);
                        ctx.font = fontSize + 'px -apple-system, BlinkMacSystemFont, sans-serif';
                        ctx.fillStyle = mindmapPalette.textColor;
                        ctx.globalAlpha = 0.8;
                        const label = node.label.length > 20 ? node.label.slice(0, 18) + '...' : node.label;
                        ctx.fillText(label, node.x + r + 3, node.y + fontSize * 0.35);
                        ctx.globalAlpha = 1;

                        node.__radius = r;
                    })
                    .nodePointerAreaPaint((node, color, ctx) => {
                        const r = node.__radius || 4;
                        ctx.beginPath();
                        ctx.arc(node.x, node.y, r + 4, 0, 2 * Math.PI);
                        ctx.fillStyle = color;
                        ctx.fill();
                    })
                    .linkColor(() => mindmapPalette.borderColor)
                    .linkWidth(0.5)
                    .linkDirectionalParticles(0)
                    .linkLineDash(link => link.type === 'page-link' ? [4, 4] : null)
                    .linkCanvasObjectMode(() => undefined)
                    .onNodeClick(node => {
                        if (node.url) window.location.href = node.url;
                    })
                    .onNodeHover(node => {
                        container.style.cursor = node ? 'pointer' : 'default';
                        graph.hoverNode = node || null;
                    })
                    .d3AlphaDecay(0.02)
                    .d3VelocityDecay(0.3)
                    .cooldownTicks(2000)
                    .warmupTicks(100)
                    .onEngineStop(() => graph.zoomToFit(400, 50))
                    .enableZoomInteraction(true)
                    .enablePanInteraction(true)
                    .enableNodeDrag(true)
                    .onNodeDragEnd(node => {
                        // Only save/pin position for parent notes (no "/" in id)
                        const isParent = node.id.indexOf('/') === -1;
                        if (isParent) {
                            node.fx = node.x;
                            node.fy = node.y;
                            fetch(homeUrl + 'api/graph/', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ id: node.id, x: node.x, y: node.y })
                            }).catch(err => console.error('Save position error:', err));
                        }
                    });

                mindmapGraph = graph;

                graph.d3Force('charge').strength(-140);
                graph.d3Force('link')
                    .distance(link => link.type === 'child' ? 40 : 45)
                    .strength(link => link.type === 'child' ? 0.9 : 0.2);
                graph.d3Force('center', null);

                // Gravity: full for parents, mild for children (link force keeps them near parent)
                var aspectRatio = width / height;
                var gravityNodes;
                function forceGravity(alpha) {
                    var k = alpha * 0.06;
                    gravityNodes.forEach(function(n) {
                        var s = n.id.indexOf('/') !== -1 ? 0.1 : 1;
                        n.vx -= n.x * k * s * (1 / aspectRatio);
                        n.vy -= n.y * k * s * aspectRatio;
                    });
                }
                forceGravity.initialize = function(nodes) { gravityNodes = nodes; };
                graph.d3Force('gravity', forceGravity);

                window.addEventListener('resize', () => {
                    graph.width(container.clientWidth).height(container.clientHeight);
                });
            })
            .catch(err => {
                console.error('Mindmap error:', err);
                container.innerHTML = '<div class="mindmap-empty">Помилка завантаження карти</div>';
            });
    }
    // --- AI Chat ---
    var aiInput = document.getElementById('ai-input');
    var aiSend = document.getElementById('ai-send');
    var aiMessages = document.getElementById('ai-messages');
    var aiScroll = document.querySelector('.content');

    if (aiInput && aiSend && aiMessages) {
        var chatHistory = JSON.parse(sessionStorage.getItem('ai-chat') || '[]');
        var aiLoading = false;

        function scrollChat() {
            if (aiScroll) aiScroll.scrollTop = aiScroll.scrollHeight;
        }

        function renderMessages() {
            aiMessages.innerHTML = '';
            chatHistory.forEach(function(msg) {
                if ((msg.role === 'user' || msg.role === 'assistant') && msg.content) {
                    var div = document.createElement('div');
                    div.className = 'ai-msg ai-msg-' + msg.role;
                    div.innerHTML = msg.role === 'assistant' ? formatAiText(msg.content) : escapeHtml(msg.content);
                    aiMessages.appendChild(div);
                }
            });
            scrollChat();
        }

        function escapeHtml(t) {
            var d = document.createElement('div');
            d.textContent = t;
            return d.innerHTML;
        }

        function formatAiText(text) {
            if (!text) return '';
            // code blocks
            text = text.replace(/```(\w*)\n([\s\S]*?)```/g, '<pre><code>$2</code></pre>');
            // inline code
            text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
            // markdown links
            text = text.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2">$1</a>');
            // bold
            text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
            // italic
            text = text.replace(/(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)/g, '<em>$1</em>');
            // line breaks
            text = text.replace(/\n/g, '<br>');
            return text;
        }

        function sendMessage() {
            var text = aiInput.value.trim();
            if (!text || aiLoading) return;

            chatHistory.push({ role: 'user', content: text });
            aiInput.value = '';
            aiInput.style.height = 'auto';
            renderMessages();

            aiLoading = true;
            aiSend.disabled = true;
            aiInput.disabled = true;

            // typing indicator
            var typing = document.createElement('div');
            typing.className = 'ai-msg ai-msg-assistant ai-typing';
            typing.innerHTML = '<span class="ai-dot"></span><span class="ai-dot"></span><span class="ai-dot"></span>';
            aiMessages.appendChild(typing);
            scrollChat();

            fetch(homeUrl + 'api/chat/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ messages: chatHistory })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (typing.parentNode) typing.remove();
                if (data.error && !data.reply) {
                    chatHistory.push({ role: 'assistant', content: '⚠️ ' + data.error });
                } else {
                    chatHistory = data.messages || chatHistory;
                    if (data.reply) {
                        // ensure last message is the reply
                        var last = chatHistory[chatHistory.length - 1];
                        if (!last || last.content !== data.reply) {
                            chatHistory.push({ role: 'assistant', content: data.reply });
                        }
                    }
                }
                sessionStorage.setItem('ai-chat', JSON.stringify(chatHistory));
                renderMessages();

                // Refresh sidebar if notes were modified
                if (data.notes_changed) {
                    fetch(homeUrl, { credentials: 'same-origin' })
                        .then(function(r) { return r.text(); })
                        .then(function(html) {
                            var doc = new DOMParser().parseFromString(html, 'text/html');
                            var newNav = doc.querySelector('.sidebar-nav');
                            var curNav = document.querySelector('.sidebar-nav');
                            if (newNav && curNav) {
                                curNav.innerHTML = newNav.innerHTML;

                                // Restore collapsed state from localStorage
                                var collapsed = JSON.parse(localStorage.getItem('sidebar-collapsed') || '[]');
                                curNav.querySelectorAll('.sidebar-folder[data-slug]').forEach(function(folder) {
                                    if (collapsed.indexOf(folder.dataset.slug) !== -1) {
                                        folder.classList.add('collapsed');
                                    }
                                });

                                // Re-bind folder toggle handlers
                                curNav.querySelectorAll('[data-toggle="folder"]').forEach(function(el) {
                                    el.addEventListener('click', function(e) {
                                        e.preventDefault();
                                        e.stopPropagation();
                                        el.closest('.sidebar-folder').classList.toggle('collapsed');
                                        var slugs = [];
                                        document.querySelectorAll('.sidebar-folder.collapsed[data-slug]').forEach(function(f) {
                                            slugs.push(f.dataset.slug);
                                        });
                                        localStorage.setItem('sidebar-collapsed', JSON.stringify(slugs));
                                    });
                                });
                            }
                        });
                }
            })
            .catch(function(err) {
                if (typing.parentNode) typing.remove();
                chatHistory.push({ role: 'assistant', content: '⚠️ Помилка з\'єднання' });
                renderMessages();
            })
            .finally(function() {
                aiLoading = false;
                aiSend.disabled = false;
                aiInput.disabled = false;
                aiInput.focus();
            });
        }

        aiSend.addEventListener('click', sendMessage);
        aiInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // Auto-resize textarea
        aiInput.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = Math.min(this.scrollHeight, 120) + 'px';
        });

        // Restore chat on load
        if (chatHistory.length) renderMessages();

        // --- AI clear button (two-click confirm) ---
        var aiClearBtn = document.getElementById('ai-clear-btn');
        var aiClearTimer = null;
        if (aiClearBtn) {
            aiClearBtn.addEventListener('click', function() {
                if (!aiClearBtn.classList.contains('confirm')) {
                    aiClearBtn.classList.add('confirm');
                    if (aiClearTimer) clearTimeout(aiClearTimer);
                    aiClearTimer = setTimeout(function() { aiClearBtn.classList.remove('confirm'); }, 3000);
                    return;
                }
                aiClearBtn.classList.remove('confirm');
                chatHistory = [];
                sessionStorage.removeItem('ai-chat');
                renderMessages();
            });
        }
    }

})();
</script>
{% endblock %}
