{% extends 'overall/base.twig' %}

{% block public %}
<div class="public-note">
    <article class="public-note-content">
        {% if note.meta.cover is defined and note.meta.cover %}
        <div class="public-note-cover">
            <img src="{{ note.meta.cover }}" alt="" style="object-position: center {{ note.meta.cover_position is defined ? note.meta.cover_position : 50 }}%">
        </div>
        {% endif %}
        <h1 class="public-note-title">
            {% if note.meta.icon %}<span class="public-note-icon">{% if note.meta.icon starts with 'data:' %}<img src="{{ note.meta.icon }}" width="28" height="28" alt="">{% else %}{{ note.meta.icon }}{% endif %}</span> {% endif %}{{ note._title }}
        </h1>
        <div class="note-date">{{ date_format_uk(note.meta.updated_at) }}</div>
        {{ render_blocks(note.content.blocks) }}
    </article>
</div>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ note._title|json_encode|raw }},
    "description": {{ page.description|json_encode|raw }},
    "datePublished": "{{ note.meta.created_at }}",
    "dateModified": "{{ note.meta.updated_at }}",
    "url": "{{ canonical }}",
    "inLanguage": "{{ site.html_loc }}",
    "author": {
        "@type": "Person",
        "name": "Віталій Капля",
        "url": "https://vitaliikaplia.com/"
    },
    "publisher": {
        "@type": "Organization",
        "name": {{ site.name|json_encode|raw }}
    }
}
</script>
{% endblock %}
