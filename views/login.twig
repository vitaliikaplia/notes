{% extends 'overall/base.twig' %}

{% block public %}
<div class="login-container">
    <div class="login-logo">
        <img src="{{ assets_url }}svg/favicon.svg{{ asset_ver('svg/favicon.svg') }}" alt="" width="96" height="96">
    </div>
    <div class="login-box">
        <h1>Нотатки</h1>
        <p class="login-subtitle">Записуйте, структуруйте, знаходьте</p>

        {% if error %}
            <div class="alert alert-error">{{ error }}</div>
        {% endif %}

        <form method="post" action="{{ home_url }}login/">
            <div class="form-group">
                <input type="text" id="user" name="user" placeholder="Логін" required autofocus>
            </div>
            <div class="form-group">
                <input type="password" id="pass" name="pass" placeholder="Пароль" required>
            </div>
            <div class="form-group form-remember">
                <label class="checkbox-label">
                    <span>Запам'ятати мене</span>
                    <input type="checkbox" name="remember" value="1">
                </label>
            </div>
            {% if captcha_site_key %}
                <div class="form-group captcha-group">
                    <div class="cf-turnstile" data-sitekey="{{ captcha_site_key }}" data-theme="auto"></div>
                </div>
            {% endif %}
            <button type="submit" class="btn btn-primary btn-full">Увійти</button>
        </form>
    </div>
</div>
{% if captcha_site_key %}
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}
{% endblock %}
